# ---------------------------------------------------------------------------
# SLMFlow Medical AI - configuration (all optional)
#
# Copy this file to `.env` and edit it, or just set the variables in your
# shell. Every value below is the default, so you can delete this file and
# the app still works.
# ---------------------------------------------------------------------------

# --- model backend -----------------------------------------------------------
# URL of the local Ollama daemon. SLMFlow's Ollama backend reads OLLAMA_HOST
# itself; the app uses it too.
OLLAMA_HOST=http://localhost:11434

# Set to 1 to run with SLMFlow's built-in MOCK backend instead of a real model.
# Every answer is clearly labelled MOCK. Useful only to demo the UI without
# Ollama installed - it is NOT model inference.
SLMFLOW_MOCK=0

# --- which models to register ------------------------------------------------
# How many of the smallest local Ollama models to register with SLMFlow.
SLMFLOW_MAX_MODELS=3
# Skip any single model larger than this many bytes (2.5 GB here).
SLMFLOW_MAX_MODEL_BYTES=2500000000
# Optional: force the model used for the answer step. By default the largest
# registered model is pinned there (the extract step is still router-decided).
# Set it to `router` to let SLMFlow's router score every registered model
# instead. Otherwise it must match a model name shown on the status card.
SLMFLOW_ANSWER_MODEL=

# --- pipeline ----------------------------------------------------------------
# single | cascade | slm_mux | adaptive | agent_forest
SLMFLOW_STRATEGY=single
# heuristic | random | learned | static:<model_id>
SLMFLOW_ROUTER=heuristic
# greedy | naive | oracle
SLMFLOW_SCHEDULER=greedy
# Confidence below which SLMFlow abstains instead of answering.
SLMFLOW_CONFIDENCE_THRESHOLD=0.5
SLMFLOW_MAX_OUTPUT_TOKENS=220
# k and temperature are only used by the sampling strategies.
SLMFLOW_K=3
SLMFLOW_TEMPERATURE=0.7

# --- memory budget -----------------------------------------------------------
# Leave empty to let SLMFlow probe this machine and use 75% of each tier.
# Set these if SLMFlow reports ResourceExhausted, or to force it to evict one
# model before loading the next (that trade-off is what SLMFlow is about).
SLMFLOW_VRAM_BUDGET_GB=
SLMFLOW_RAM_BUDGET_GB=

# --- document handling -------------------------------------------------------
MAX_UPLOAD_MB=15
CHUNK_SIZE=1100
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=3

# --- server ------------------------------------------------------------------
# Where SLMFlow writes its own JSONL run trace.
SLMFLOW_TRACE_PATH=backend/data/slmflow_runs.jsonl
